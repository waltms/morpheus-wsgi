diff -ruN stemlib/Greek/addconstraints.pl.orig /var/www/wsgi/morpheus/stemlib/Greek/addconstraints.pl.orig
--- stemlib/Greek/addconstraints.pl.orig	1969-12-31 18:00:00.000000000 -0600
+++ /var/www/wsgi/morpheus/stemlib/Greek/addconstraints.pl.orig	2026-04-23 11:21:37.989186594 -0500
@@ -0,0 +1,45 @@
+#!/usr/bin/perl
+open FIN, "< stemsrc/entitylist-byhand.txt";
+
+while(<FIN>) {
+	@fields = split /\s+/;
+	$curlem = @fields[0];
+
+	$curtype{$curlem} = @fields[1];		
+}
+
+while(<>) {
+
+	if( /:le:(.+)/ ) {
+		$curlemma = $1;
+		$curlemma =~ s#\s+$##g;
+	}
+
+	if( /^:no:/ and $curtype{$curlemma} =~ /person/ and ! /pers_name/ ) {
+		$sent2 = $_;
+		$sent2 =~ s#(.+)#$1 is_group#;
+		s#(.+)#$1 pers_name#;
+	}
+
+#personal names are by default singular
+#tried to comment this out bc too many people want to talk about your Platos and Protagorases but no luck
+	if( /pers_name/ and ! /\bsg/  ) {
+		s#(pers_name)#$1 sg#g;
+	}
+	print;
+
+# Commented out the following because it appended -pl to the lemma
+# and created groups where a name had multiple stems -WMS -Helma
+
+	#if(/:no.+pers_name/ ) {
+	#	$groupv = $_;
+	#	$savev = $groupv;
+	#	$groupv =~ s#pers_name#is_group#;
+	#	$groupv =~ s#\bsg\b#pl#;
+	#	print ":le:$curlemma-pl\n$groupv\n$curlemma\n";
+#	
+#		$groupv = $savev;
+#		$groupv =~ s#\bsg\b#dual#;
+#		print ":le:$curlemma-pl\n$groupv\n$curlemma\n";
+#	}
+}
